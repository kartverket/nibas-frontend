{
  "name": "nibas-klient",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "dependencies": {
    "@grafana/faro-react": "^1.17.2",
    "@kvib/react": "^4.3.3",
    "date-fns": "^4.1.0",
    "lodash.get": "^4.4.2",
    "ol": "^10.5.0",
    "material-symbols": "^0.31.2",
    "proj4": "~2.15.0",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "react-hook-form": "~7.51.5",
    "react-oidc-context": "^3.3.0",
    "react-router": "^7.5.3",
    "react-router-dom": "^7.5.2",
    "styled-components": "^6.1.17",
    "swr": "~2.3.3"
  },
  "overrides": {
    "@grafana/faro-react": {
      "react-router-dom": "7.5.2"
    }
  },
  "scripts": {
    "start": "vite",
    "start:no-auth": "cross-env VITE_DISABLE_AUTH=true vite",
    "build": "tsc && vite build",
    "dev": "vite --debug",
    "serve": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch --passWithNoTests",
    "test:coverage": "npm test -- src/* --coverage",
    "lint": "eslint src --max-warnings 0 && stylelint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "update-api-types": "npx openapi-typescript@5 http://localhost:8080/api-docs --output src/types/api-gen.ts",
    "update-api-types-arbeidsliste": "npx openapi-typescript@5 http://localhost:8082/api-docs --output src/types/api-gen-arbeidsliste.ts",
    "format": "prettier --write .",
    "clean": "rm -rf node_modules/.vite/"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.9",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.25.1",
    "@grafana/faro-react": "^1.17.2",
    "@testing-library/jest-dom": "~6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash.get": "^4.4.9",
    "@types/node": "~22.15.2",
    "@types/proj4": "~2.5.6",
    "@types/react": "~18.3.3",
    "@types/react-dom": "~18.3.0",
    "@types/styled-components": "^5.1.34",
    "@typescript-eslint/eslint-plugin": "8.31.1",
    "@typescript-eslint/parser": "8.31.1",
    "@vitejs/plugin-react": "^4.4.1",
    "cross-env": "^7.0.3",
    "eslint": "~9.25.1",
    "eslint-config-prettier": "~10.1.2",
    "eslint-import-resolver-typescript": "~4.3.4",
    "eslint-plugin-import": "~2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "~7.37.5",
    "eslint-plugin-react-hooks": "~5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "msw": "~2.7.5",
    "postcss-styled-syntax": "^0.7.1",
    "prettier": "^3.5.3",
    "stylelint": "^16.19.1",
    "stylelint-config-standard": "^38.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.4",
    "vite-plugin-checker": "^0.9.1",
    "vite-plugin-eslint": "^1.8.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.2"
  },
  "prettier": {
    "printWidth": 120
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ],
    "customSyntax": "postcss-styled-syntax",
    "defaultSeverity": "warning",
    "rules": {
      "custom-property-pattern": "^([a-z][a-zA-Z0-9]*)(-[a-zA-Z0-9]+)*$",
      "declaration-empty-line-before": [
        "never",
        {
          "ignore": [
            "after-declaration"
          ]
        }
      ],
      "declaration-block-no-redundant-longhand-properties": [
        true,
        {
          "ignoreShorthands": [
            "grid-template"
          ]
        }
      ],
      "color-function-notation": null
    }
  }
}

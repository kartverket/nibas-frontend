  "private": true,
  "dependencies": {
    "@kartverket/frontend-aut-lib": "0.0.27",
    "@kvib/react": "^2.0.0",
    "lodash.get": "^4.4.2",
    "material-symbols": "^0.5.4",
    "ol": "^8.1.0",
    "proj4": "~2.9.0",
    "react": "~18.2.0",
    "react-dnd": "~16.0.1",

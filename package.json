{
  "name": "nibas-klient",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "dependencies": {
    "@kvib/react": "^4.3.0",
    "date-fns": "^3.3.1",
    "material-symbols": "^0.17.2",
    "lodash.get": "^4.4.2",
    "ol": "^9.0.0",
    "proj4": "~2.10.0",
    "react": "~18.2.0",
    "react-dom": "~18.2.0",
    "react-hook-form": "~7.51.0",
    "react-oidc-context": "^3.0.0",
    "react-router-dom": "~6.22.3",
    "stacktrace-js": "^2.0.2",
    "styled-components": "^6.1.8",
    "swr": "~2.2.5"
  },
  "scripts": {
    "start": "vite",
    "start:no-auth": "cross-env VITE_DISABLE_AUTH=true vite",
    "build": "tsc && vite build",
    "cypress:run": "cypress run",
    "cypress:headed": "cypress run --headed --no-exit",
    "dev": "vite --debug",
    "serve": "vite preview",
    "test": "vitest",
    "test:coverage": "npm test -- src/* --coverage",
    "lint": "eslint src --max-warnings 0 && stylelint src --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "update-api-types": "npx openapi-typescript@5 http://localhost:8080/api-docs --output src/types/api-gen.ts",
    "format": "prettier --write ."
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "~6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/lodash.get": "^4.4.9",
    "@types/node": "~20.11.25",
    "@types/proj4": "~2.5.5",
    "@types/react": "~18.2.64",
    "@types/react-dom": "~18.2.21",
    "@types/react-router-dom": "~5.3.3",
    "@types/styled-components": "^5.1.34",
    "@typescript-eslint/eslint-plugin": "~7.1.1",
    "@typescript-eslint/parser": "~7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^7.0.3",
    "cypress": "^13.7.1",
    "eslint": "~8.57.0",
    "eslint-config-prettier": "~9.1.0",
    "eslint-import-resolver-typescript": "~3.6.1",
    "eslint-plugin-import": "~2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "~7.34.0",
    "eslint-plugin-react-hooks": "~4.6.0",
    "jsdom": "^24.0.0",
    "msw": "~2.2.3",
    "postcss-styled-syntax": "^0.6.4",
    "prettier": "^3.2.5",
    "stylelint": "^16.3.0",
    "stylelint-config-standard": "^36.0.0",
    "typescript": "~5.4.2",
    "vite": "^5.1.5",
    "vite-plugin-checker": "^0.6.4",
    "vite-plugin-eslint": "^1.8.1",
    "vite-tsconfig-paths": "^4.3.1",
    "vitest": "^1.3.1"
  },
  "prettier": {
    "printWidth": 120
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ],
    "customSyntax": "postcss-styled-syntax",
    "defaultSeverity": "warning",
    "rules": {
      "custom-property-pattern": "^([a-z][a-zA-Z0-9]*)(-[a-zA-Z0-9]+)*$",
      "declaration-empty-line-before": [
        "never",
        {
          "ignore": [
            "after-declaration"
          ]
        }
      ],
      "declaration-block-no-redundant-longhand-properties": [
        true,
        {
          "ignoreShorthands": [
            "grid-template"
          ]
        }
      ],
      "color-function-notation": null
    }
  }
}

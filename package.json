{
  "name": "nibas-klient",
  "version": "0.2.3",
  "private": true,
  "dependencies": {
    "@kartverket/frontend-aut-lib": "0.0.27",
    "@kvib/css": "^4.0.0",
    "http-proxy-middleware": "~2.0.6",
    "i18next": "^22.5.1",
    "i18next-http-backend": "^2.2.1",
    "lodash.orderby": "^4.6.0",
    "ol": "~7.4.0",
    "proj4": "~2.9.0",
    "react": "~18.2.0",
    "react-dnd": "~16.0.1",
    "react-dnd-html5-backend": "~16.0.1",
    "react-dom": "~18.2.0",
    "react-hook-form": "~7.44.3",
    "react-i18next": "^12.3.1",
    "react-modal": "^3.16.1",
    "react-router-dom": "~6.11.0",
    "styled-components": "~5.3.11",
    "swr": "~2.1.5"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "test": "react-scripts test",
    "test:coverage": "npm test -- src/* --coverage",
    "eject": "react-scripts eject",
    "lint": "eslint src",
    "lint:fix": "npm run lint -- --fix",
    "update-api-types": "npx openapi-typescript@5 http://localhost:8080/api-docs --output src/types/api-gen.ts",
    "update-api-types:remote": "npx openapi-typescript@5 http://nibas-backend.tz2-test-apps.k8s.local/api-docs --output src/types/api-gen.ts",
    "scan-translations": "i18next-scanner --config src/i18n/i18next-scanner.config.js 'src/**/*.{ts,tsx}'"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "~5.16.5",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "~29.5.2",
    "@types/lodash.orderby": "^4.6.7",
    "@types/node": "~20.3.0",
    "@types/proj4": "~2.5.2",
    "@types/react": "~18.2.11",
    "@types/react-dom": "~18.2.4",
    "@types/react-modal": "^3.16.0",
    "@types/react-router-dom": "~5.3.3",
    "@types/styled-components": "~5.1.26",
    "@typescript-eslint/eslint-plugin": "~5.59.9",
    "@typescript-eslint/parser": "~5.59.9",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "~8.42.0",
    "eslint-config-prettier": "~8.8.0",
    "eslint-import-resolver-typescript": "~3.5.5",
    "eslint-plugin-import": "~2.27.5",
    "eslint-plugin-prettier": "~4.2.1",
    "eslint-plugin-react": "~7.32.2",
    "eslint-plugin-react-hooks": "~4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "i18next-scanner": "^4.2.0",
    "msw": "~1.2.2",
    "prettier": "~2.8.8",
    "typescript": "~5.1.3",
    "vite": "^4.3.9",
    "vite-plugin-eslint": "^1.8.1",
    "vite-tsconfig-paths": "^4.2.0"
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(ol|@kartverket/frontend-aut-lib)/)"
    ],
    "resetMocks": false,
    "moduleNameMapper": {
      "\\.(css|less)$": "<rootDir>/__mocks__/styleMock.ts"
    }
  }
}

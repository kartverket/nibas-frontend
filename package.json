{
  "name": "nibas-klient",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "dependencies": {
    "@grafana/faro-react": "^2.3.1",
    "@kvib/react": "^4.3.3",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "js-yaml": "^4.1.1",
    "lodash.get": "^4.4.2",
    "material-symbols": "^0.43.0",
    "minimatch": "^10.2.4",
    "ol": "^10.8.0",
    "proj4": "~2.20.4",
    "react": "~18.3.1",
    "react-compiler-runtime": "^19.1.0-rc.3",
    "react-dom": "~18.3.1",
    "react-hook-form": "~7.72.0",
    "oidc-client-ts": "^3.5.0",
    "react-oidc-context": "^3.3.1",
    "react-router": "^7.13.2",
    "react-router-dom": "^7.13.2",
    "react-select": "^5.10.2",
    "styled-components": "^6.3.12",
    "swr": "~2.4.1"
  },
  "overrides": {
    "@grafana/faro-react": {
      "react-router-dom": "^7.5.2"
    }
  },
  "scripts": {
    "start": "vite",
    "start:no-auth": "cross-env VITE_DISABLE_AUTH=true vite",
    "build": "tsc && vite build",
    "dev": "vite --debug",
    "serve": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch --passWithNoTests",
    "test:coverage": "npm test -- src/* --coverage",
    "lint": "eslint src --max-warnings 0 && stylelint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "update-api-types": "openapi-typescript http://localhost:8080/api-docs --output src/types/api-gen.ts",
    "update-api-types-arbeidsliste": "openapi-typescript http://localhost:8082/api-docs --output src/types/api-gen-arbeidsliste.ts",
    "format": "prettier --write .",
    "clean": "rm -rf node_modules/.vite/"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^3.0.0",
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@grafana/faro-react": "^2.3.1",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash.get": "^4.4.9",
    "@types/node": "~25.5.0",
    "@types/proj4": "~2.19.0",
    "@types/react": "~18.3.3",
    "@types/react-dom": "~18.3.0",
    "@types/styled-components": "^5.1.36",
    "@typescript-eslint/eslint-plugin": "8.57.2",
    "@typescript-eslint/parser": "8.57.2",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "cross-env": "^10.1.0",
    "eslint": "~10.1.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-import-resolver-typescript": "~4.4.4",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "~7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "~7.0.1",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "msw": "~2.12.14",
    "openapi-typescript": "^7.13.0",
    "postcss-styled-syntax": "^0.7.1",
    "prettier": "^3.8.1",
    "stylelint": "17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.9.2",
    "vite": "^8.0.3",
    "vite-plugin-checker": "^0.12.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.2"
  },
  "prettier": {
    "printWidth": 120
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ],
    "customSyntax": "postcss-styled-syntax",
    "defaultSeverity": "warning",
    "rules": {
      "custom-property-pattern": "^([a-z][a-zA-Z0-9]*)(-[a-zA-Z0-9]+)*$",
      "declaration-empty-line-before": [
        "never",
        {
          "ignore": [
            "after-declaration"
          ]
        }
      ],
      "declaration-block-no-redundant-longhand-properties": [
        true,
        {
          "ignoreShorthands": [
            "grid-template"
          ]
        }
      ],
      "color-function-notation": null,
      "nesting-selector-no-missing-scoping-root": null
    }
  }
}

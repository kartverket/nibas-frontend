{
  "name": "nibas-klient",
  "version": "0.1.73",
  "private": true,
  "dependencies": {
    "@kartverket/frontend-aut-lib": "0.0.21",
    "@kartverket/kvib-css": "^1.0.31",
    "@types/react-modal": "^3.13.1",
    "http-proxy-middleware": "~2.0.1",
    "i18next": "^21.6.14",
    "i18next-http-backend": "^1.4.0",
    "ol": "~6.8.1",
    "proj4": "~2.7.5",
    "react": "~17.0.2",
    "react-dnd": "~14.0.4",
    "react-dnd-html5-backend": "~14.0.2",
    "react-dom": "~17.0.2",
    "react-hook-form": "~7.28.1",
    "react-i18next": "^11.16.2",
    "react-modal": "^3.15.1",
    "react-router-dom": "~6.2.1",
    "styled-components": "~5.3.1",
    "swr": "~1.2.1",
    "web-vitals": "~1.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:coverage": "npm test -- src/* --coverage",
    "eject": "react-scripts eject",
    "lint": "eslint src",
    "lint:fix": "npm run lint -- --fix",
    "update-api-types": "npx openapi-typescript http://localhost:8080/api-docs --output src/types/api-gen.ts",
    "update-api-types:remote": "npx openapi-typescript http://nibas-backend.tz2-test-apps.k8s.local/api-docs --output src/types/api-gen.ts",
    "scan-translations": "i18next-scanner --config src/i18n/i18next-scanner.config.js 'src/**/*.{ts,tsx}'"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "~5.11.4",
    "@testing-library/react": "^12.1.5",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "~26.0.15",
    "@types/node": "~12.0.0",
    "@types/proj4": "~2.5.2",
    "@types/react": "~17.0.0",
    "@types/react-dom": "~17.0.0",
    "@types/react-router-dom": "~5.3.3",
    "@types/styled-components": "~5.1.14",
    "@typescript-eslint/eslint-plugin": "~5.38.0",
    "@typescript-eslint/parser": "~5.38.0",
    "eslint": "~8.23.1",
    "eslint-config-prettier": "~8.3.0",
    "eslint-import-resolver-typescript": "~2.5.0",
    "eslint-plugin-import": "~2.26.0",
    "eslint-plugin-prettier": "~4.2.1",
    "eslint-plugin-react": "~7.31.8",
    "eslint-plugin-react-hooks": "~4.6.0",
    "i18next-scanner": "^3.1.0",
    "msw": "~0.36.3",
    "prettier": "~2.7.1",
    "react-scripts": "5.0.1",
    "typescript": "~4.8.3"
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(ol|@kartverket/frontend-aut-lib)/)"
    ],
    "resetMocks": false,
    "moduleNameMapper": {
      "\\.(css|less)$": "<rootDir>/__mocks__/styleMock.ts"
    }
  }
}
